# App secret from Meta App Dashboard → App settings → Basic.
# Required before the data-deletion and deauthorize callbacks will accept requests.
META_APP_SECRET=

# Optional. If empty, deletion receipts are signed with META_APP_SECRET.
DELETION_SIGNING_SECRET=

# Public site origin, no trailing slash. Used for metadata and callback status links.
# Example: https://viralos-landing.vercel.app
NEXT_PUBLIC_SITE_URL=
